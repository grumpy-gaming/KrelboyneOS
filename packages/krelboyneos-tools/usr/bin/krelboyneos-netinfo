#!/bin/sh
# KrelboyneOS panel readout for xfce4-genmon-plugin
# Prints the LAN IP and the VPN IP using the genmon tags (<txt>, <tool>, <txtclick>).
# VPN interfaces recognised: tun*, tap*, wg*, tailscale*, ppp*

lan_if=""; lan_ip=""; vpn_if=""; vpn_ip=""

for ifc in $(ip -o link show up | awk -F': ' '{print $2}' | cut -d@ -f1); do
  ip4=$(ip -o -4 addr show dev "$ifc" scope global 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -n1)
  [ -n "$ip4" ] || continue
  case "$ifc" in
    tun*|tap*|wg*|tailscale*|ppp*)
      [ -n "$vpn_ip" ] || { vpn_if="$ifc"; vpn_ip="$ip4"; } ;;
    docker*|br-*|veth*|virbr*) ;;
    *)
      [ -n "$lan_ip" ] || { lan_if="$ifc"; lan_ip="$ip4"; } ;;
  esac
done

if [ -n "$lan_ip" ]; then
  lan="<span fgcolor='#2dd4bf'>$lan_if $lan_ip</span>"
else
  lan="<span fgcolor='#f87171'>no network</span>"
fi

if [ -n "$vpn_ip" ]; then
  vpn="<span fgcolor='#4ade80'>VPN $vpn_ip</span>"
else
  vpn="<span fgcolor='#94a3b8'>VPN off</span>"
fi

echo "<txt> $lan  |  $vpn </txt>"
echo "<tool>$(ip -br -4 addr show)</tool>"
echo "<txtclick>nm-connection-editor</txtclick>"
