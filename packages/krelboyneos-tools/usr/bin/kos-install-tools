#!/bin/bash
# KrelboyneOS extra tools installer
#   kos-install-tools                  menu in the terminal
#   kos-install-tools install <tool>   install one tool (KOS Software uses this)
#   kos-install-tools apt <package>    install a Debian package
#   kos-install-tools update           update the whole system
# Each step ends with "|| return 1" so a failed step stops that tool and reports it.
set -o pipefail

DEV_TOOLS=(stevie bruno playwright_mcp)
SEC_TOOLS=(metasploit bloodhound burp agency_security subfinder naabu dnsx katana amass chisel ligolo mitm6 theharvester netexec)

# KOS Software sets SUDO_ASKPASS so sudo asks for the password in a window.
# Nothing is piped into sudo, so the password is only asked once per install.
sudo() {
  if [ -n "$SUDO_ASKPASS" ]; then command sudo -A "$@"; else command sudo "$@"; fi
}

# apt-get that never stops to ask questions
apt_get() {
  sudo env DEBIAN_FRONTEND=noninteractive apt-get -y \
    -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold "$@"
}

install_bruno() {
  echo "== Bruno =="
  local tmp
  tmp=$(mktemp -d) || return 1
  curl -fsSL "https://keyserver.ubuntu.com/pks/lookup?op=get&search=0x9FA6017ECABE0266" \
    | gpg --dearmor > "$tmp/bruno.gpg" || { rm -rf "$tmp"; return 1; }
  echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/bruno.gpg] http://debian.usebruno.com/ bruno stable" > "$tmp/bruno.list"
  sudo install -D -m 644 "$tmp/bruno.gpg" /etc/apt/keyrings/bruno.gpg || { rm -rf "$tmp"; return 1; }
  sudo install -m 644 "$tmp/bruno.list" /etc/apt/sources.list.d/bruno.list || { rm -rf "$tmp"; return 1; }
  rm -rf "$tmp"
  apt_get update || return 1
  apt_get install bruno || return 1
}

install_metasploit() {
  echo "== Metasploit =="
  local tmp
  tmp=$(mktemp -d) || return 1
  curl -fsSL https://raw.githubusercontent.com/rapid7/metasploit-omnibus/master/config/templates/metasploit-framework-wrappers/msfupdate.erb -o "$tmp/msfinstall" || { rm -rf "$tmp"; return 1; }
  chmod 755 "$tmp/msfinstall"
  sudo "$tmp/msfinstall" || { rm -rf "$tmp"; return 1; }
  rm -rf "$tmp"
}

install_bloodhound() {
  echo "== BloodHound CE =="
  sudo systemctl start docker || return 1
  mkdir -p ~/bloodhound || return 1
  cd ~/bloodhound || return 1
  curl -fsSL https://github.com/SpecterOps/bloodhound-cli/releases/latest/download/bloodhound-cli-linux-amd64.tar.gz -o bloodhound-cli.tar.gz || return 1
  tar -xzf bloodhound-cli.tar.gz || return 1
  rm -f bloodhound-cli.tar.gz
  sudo ./bloodhound-cli install || return 1
  echo "Save the admin password above. Then open http://localhost:8080/ui/login"
}

install_burp() {
  echo "== Burp Suite Community =="
  local tmp progress=--progress-bar
  [ -t 2 ] || progress=-sS   # no progress bar when KOS Software shows the output
  tmp=$(mktemp -d) || return 1
  echo "Downloading the installer (about 400 MB)..."
  curl -fL $progress "https://portswigger.net/burp/releases/download?product=community&type=Linux" -o "$tmp/burp-installer.sh" || { rm -rf "$tmp"; return 1; }
  # -q = unattended install into your home folder, with a menu entry
  sh "$tmp/burp-installer.sh" -q || { rm -rf "$tmp"; return 1; }
  rm -rf "$tmp"
  echo "Burp Suite is in your applications menu."
}

# --- AI agent tools: pinned to versions checked for KOS, installed in your home folder ---

PLAYWRIGHT_MCP_VERSION=0.0.83
AGENCY_COMMIT=b37b5bb33b78f2c1d6567d98e25ca818e3259219

install_playwright_mcp() {
  echo "== Playwright MCP $PLAYWRIGHT_MCP_VERSION =="
  npm install -g --prefix ~/.local/share/kos-playwright-mcp --no-fund --no-audit \
    "@playwright/mcp@$PLAYWRIGHT_MCP_VERSION" || return 1
  # Playwright's Chromium carries a newer fontconfig that rewrites the font cache
  # in a format the system can't read (every font turns into icons), so the
  # command is a wrapper that gives it a cache folder of its own.
  mkdir -p ~/.local/bin && rm -f ~/.local/bin/playwright-mcp || return 1
  cat > ~/.local/bin/playwright-mcp <<'EOF' || return 1
#!/bin/sh
# Playwright MCP, installed by KOS Software. Its Chromium gets its own font cache,
# because its newer fontconfig breaks the system's (see kos-install-tools).
export PLAYWRIGHT_BROWSERS_PATH="${PLAYWRIGHT_BROWSERS_PATH:-${XDG_CACHE_HOME:-$HOME/.cache}/ms-playwright}"
export XDG_CACHE_HOME="$HOME/.cache/kos-playwright-mcp"
exec "$HOME/.local/share/kos-playwright-mcp/bin/playwright-mcp" "$@"
EOF
  chmod 755 ~/.local/bin/playwright-mcp || return 1
  echo "Downloading Playwright's Chromium (about 700 MB)..."
  ~/.local/bin/playwright-mcp install-browser chromium || return 1
}

# Stevie's AI: Ollama (pinned version, official installer) and Stevie's default model
OLLAMA_VERSION=0.40.13
STEVIE_MODEL=qwen3:4b-instruct
install_stevie() {
  echo "== Stevie's AI: Ollama $OLLAMA_VERSION and $STEVIE_MODEL =="
  if ! command -v ollama > /dev/null; then
    local tmp i
    tmp=$(mktemp -d) || return 1
    curl -fsSL https://ollama.com/install.sh -o "$tmp/install.sh" || { rm -rf "$tmp"; return 1; }
    # Run as root, so the installer's own sudo calls are not needed (they cannot use a password window)
    sudo env OLLAMA_VERSION="$OLLAMA_VERSION" sh "$tmp/install.sh" || { rm -rf "$tmp"; return 1; }
    rm -rf "$tmp"
    sudo usermod -aG ollama "$USER" || return 1
    for i in $(seq 30); do
      curl -fsS -o /dev/null http://127.0.0.1:11434/api/version && break
      sleep 1
    done
  fi
  echo "Downloading $STEVIE_MODEL (about 2.5 GB)..."
  ollama pull "$STEVIE_MODEL" || return 1
}

# The Agency's security roles, each checked against the hash of the reviewed copy
install_agency_security() {
  echo "== AI agent roles: security =="
  local sums=/usr/share/kos-software/agency-agents-security.sha256 tmp f
  tmp=$(mktemp -d) || return 1
  while read -r _ f; do
    curl -fsSL "https://raw.githubusercontent.com/msitarzewski/agency-agents/$AGENCY_COMMIT/security/$f" -o "$tmp/$f" \
      || { rm -rf "$tmp"; return 1; }
  done < "$sums"
  (cd "$tmp" && sha256sum --quiet -c "$sums") || { echo "A download does not match the checked copy."; rm -rf "$tmp"; return 1; }
  mkdir -p ~/.claude/agents && install -m 644 "$tmp"/*.md ~/.claude/agents/ || { rm -rf "$tmp"; return 1; }
  rm -rf "$tmp"
  echo "Installed $(wc -l < "$sums") roles in ~/.claude/agents."
}

# --- Wave 3: Go release binaries and pipx tools ---
# Uses the github.com "releases/latest" redirect to find the version, not
# api.github.com (which has a 60/hour limit that breaks unauthenticated builds).

gh_tag() {  # $1 repo -> latest tag, e.g. v2.17.0
  curl -fsSLI -o /dev/null -w '%{url_effective}' "https://github.com/$1/releases/latest" | sed 's#.*/tag/##'
}

fetch() {  # $1 url -> $2 file; fails if the download is missing or empty
  curl -fL "$1" -o "$2" && [ -s "$2" ]
}

install_pd_zip() {  # ProjectDiscovery-style zip: $1 repo, $2 binary name
  local tag ver tmp
  tag=$(gh_tag "$1") && [ -n "$tag" ] || return 1
  ver=${tag#v}
  tmp=$(mktemp -d) || return 1
  fetch "https://github.com/$1/releases/download/$tag/${2}_${ver}_linux_amd64.zip" "$tmp/a.zip" \
    && unzip -tq "$tmp/a.zip" > /dev/null 2>&1 || { rm -rf "$tmp"; return 1; }
  sudo unzip -o "$tmp/a.zip" "$2" -d /usr/local/bin && sudo chmod 755 "/usr/local/bin/$2" || { rm -rf "$tmp"; return 1; }
  rm -rf "$tmp"
}

install_subfinder() { echo "== subfinder =="; install_pd_zip projectdiscovery/subfinder subfinder; }
install_naabu()     { echo "== naabu =="; install_pd_zip projectdiscovery/naabu naabu; }
install_dnsx()      { echo "== dnsx =="; install_pd_zip projectdiscovery/dnsx dnsx; }
install_katana()    { echo "== katana =="; install_pd_zip projectdiscovery/katana katana; }

install_amass() {
  echo "== amass =="
  local tmp bin
  tmp=$(mktemp -d) || return 1
  # amass asset name has no version, so latest/download works directly
  fetch "https://github.com/owasp-amass/amass/releases/latest/download/amass_linux_amd64.tar.gz" "$tmp/a.tgz" \
    && tar -tzf "$tmp/a.tgz" > /dev/null 2>&1 || { rm -rf "$tmp"; return 1; }
  tar -xzf "$tmp/a.tgz" -C "$tmp" || { rm -rf "$tmp"; return 1; }
  bin=$(find "$tmp" -type f -name amass | head -1)
  [ -n "$bin" ] && sudo install -m 755 "$bin" /usr/local/bin/amass || { rm -rf "$tmp"; return 1; }
  rm -rf "$tmp"
}

install_chisel() {
  echo "== chisel =="
  local tag ver tmp
  tag=$(gh_tag jpillora/chisel) && [ -n "$tag" ] || return 1
  ver=${tag#v}
  tmp=$(mktemp -d) || return 1
  fetch "https://github.com/jpillora/chisel/releases/download/$tag/chisel_${ver}_linux_amd64.gz" "$tmp/chisel.gz" \
    && gunzip -t "$tmp/chisel.gz" > /dev/null 2>&1 || { rm -rf "$tmp"; return 1; }
  gunzip -c "$tmp/chisel.gz" | sudo tee /usr/local/bin/chisel > /dev/null || { rm -rf "$tmp"; return 1; }
  sudo chmod 755 /usr/local/bin/chisel
  rm -rf "$tmp"
}

install_ligolo() {
  echo "== ligolo-ng =="
  local tag ver tmp part bin
  tag=$(gh_tag nicocha30/ligolo-ng) && [ -n "$tag" ] || return 1
  ver=${tag#v}
  tmp=$(mktemp -d) || return 1
  for part in proxy agent; do
    fetch "https://github.com/nicocha30/ligolo-ng/releases/download/$tag/ligolo-ng_${part}_${ver}_linux_amd64.tar.gz" "$tmp/$part.tgz" \
      && tar -tzf "$tmp/$part.tgz" > /dev/null 2>&1 || { rm -rf "$tmp"; return 1; }
    mkdir -p "$tmp/$part" && tar -xzf "$tmp/$part.tgz" -C "$tmp/$part" || { rm -rf "$tmp"; return 1; }
    bin=$(find "$tmp/$part" -type f -name "$part" | head -1)
    [ -n "$bin" ] && sudo install -m 755 "$bin" "/usr/local/bin/ligolo-$part" || { rm -rf "$tmp"; return 1; }
  done
  rm -rf "$tmp"
  echo "Installed ligolo-proxy and ligolo-agent."
}

# pipx --global installs into /opt/pipx with the commands in /usr/local/bin
install_pipx() { echo "== $2 =="; sudo pipx install --global "$1"; }
install_mitm6()        { install_pipx mitm6 mitm6; }
install_theharvester() { install_pipx theHarvester theHarvester; }
install_netexec()      { install_pipx "git+https://github.com/Pennyw0rth/NetExec.git" netexec; }

tool_label() {
  case "$1" in
    bruno) echo "Bruno (API client)" ;;
    metasploit) echo "Metasploit Framework" ;;
    bloodhound) echo "BloodHound CE (needs 8 GB RAM)" ;;
    burp) echo "Burp Suite Community" ;;
    stevie) echo "Stevie's AI (Ollama + local model)" ;;
    playwright_mcp) echo "Playwright MCP (browser for AI agents)" ;;
    agency_security) echo "AI agent roles: security" ;;
    *) echo "$1" ;;
  esac
}

# Run one installer and report the result
run() {
  if "install_$1"; then
    echo "Done: $1"
  else
    echo "FAILED: $1 (see the messages above)"
  fi
}

check_network() {
  if ! curl -fsS --max-time 10 -o /dev/null https://deb.debian.org; then
    echo "No internet connection. Connect to a network and try again."
    return 1
  fi
}

# Menu for one group: $1 = title, the rest = its tools
group_menu() {
  local title=$1 choice i
  shift
  local tools=("$@")
  while true; do
    echo
    echo "$title"
    for i in "${!tools[@]}"; do
      echo "  $((i + 1))) $(tool_label "${tools[$i]}")"
    done
    echo "  a) All ${title,,}"
    echo "  b) Back"
    read -rp "Pick one: " choice
    case "$choice" in
      a|A) for i in "${tools[@]}"; do run "$i"; done ;;
      b|B) return ;;
      *)
        if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#tools[@]} )); then
          run "${tools[$((choice - 1))]}"
        else
          echo "Not a valid choice."
        fi ;;
    esac
  done
}

case "$1" in
  install)
    if [ -z "$2" ] || ! declare -F "install_$2" > /dev/null; then
      echo "Unknown tool: $2"
      exit 2
    fi
    check_network || exit 1
    "install_$2"
    exit $? ;;
  apt)
    shift
    [ $# -gt 0 ] || { echo "Usage: kos-install-tools apt <package>..."; exit 2; }
    check_network || exit 1
    apt_get update && apt_get install "$@"
    exit $? ;;
  update)
    check_network || exit 1
    apt_get update && apt_get full-upgrade
    exit $? ;;
  "") ;;
  *)
    echo "Usage: kos-install-tools [install <tool> | apt <package>... | update]"
    exit 2 ;;
esac

check_network || exit 1

while true; do
  echo
  echo "KrelboyneOS extra tools"
  echo "  1) Development"
  echo "  2) Security"
  echo "  q) Quit"
  read -rp "Pick one: " choice
  case "$choice" in
    1) group_menu "Development tools" "${DEV_TOOLS[@]}" ;;
    2) group_menu "Security tools" "${SEC_TOOLS[@]}" ;;
    q|Q) break ;;
    *) echo "Not a valid choice." ;;
  esac
done
