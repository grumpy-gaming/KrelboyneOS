#!/usr/bin/python3
# KOS Doctor: a checkup for KrelboyneOS. Shows the computer's health and fixes common problems
# one at a time.
#   Checks: /usr/share/kos-doctor/checks.ini
#   Ignored checks: ~/.config/kos-doctor/ignored (one id per line)
#   kos-doctor                a window: health overview, checks with a Fix button per problem
#   kos-doctor --check        the same in the terminal (exit 1 if anything needs fixing)
#   kos-doctor --fix ID       show the fix for one check, ask, run it, check again
#   kos-doctor --explain ID   say what a check looks for and what its fix does
#   kos-doctor --ignore ID    stop reporting a check (--unignore ID to report it again)
# Health comes from udisks (drives), UPower (battery), statvfs and /proc/meminfo: no root needed.
import argparse
import configparser
import os
import subprocess
import sys
import threading

CHECKS_FILE = os.environ.get("KOS_DOCTOR_CHECKS", "/usr/share/kos-doctor/checks.ini")
IGNORED_FILE = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")),
                            "kos-doctor", "ignored")
ASKPASS = "/usr/local/bin/kos-askpass"
LOGO = "/usr/share/krelboyneos/branding/logo.png"
TIMEOUT = 30  # seconds for one test or detail
GROUPS = [("checkup", "Checkup"), ("catch-up", "Older versions")]

# KOS teal for OK, red for problems; plain text when not on a terminal
if sys.stdout.isatty():
    OK, WARN, BAD, DIM, END = "\033[1;36m", "\033[1;33m", "\033[1;31m", "\033[2m", "\033[0m"
else:
    OK = WARN = BAD = DIM = END = ""


def shell(command):
    """Run a shell command as the user; return (exit code, output)."""
    try:
        result = subprocess.run(["sh", "-c", command], stdin=subprocess.DEVNULL, capture_output=True,
                                text=True, errors="replace", timeout=TIMEOUT)
        return result.returncode, result.stdout.strip()
    except subprocess.TimeoutExpired:
        return 1, ""


# ---- health ----

def level(value, warn, bad, high_is_bad=True):
    """'ok', 'warn' or 'bad' for a value against two limits."""
    if high_is_bad:
        return "bad" if value >= bad else "warn" if value >= warn else "ok"
    return "bad" if value <= bad else "warn" if value <= warn else "ok"


def drive_cards(bus):
    """One card per internal drive that reports health through udisks."""
    from gi.repository import Gio, GLib
    om = Gio.DBusProxy.new_sync(bus, 0, None, "org.freedesktop.UDisks2", "/org/freedesktop/UDisks2",
                                "org.freedesktop.DBus.ObjectManager", None)
    objects = om.call_sync("GetManagedObjects", None, 0, 5000, None).unpack()[0]
    cards = []
    for path, ifaces in sorted(objects.items()):
        drive = ifaces.get("org.freedesktop.UDisks2.Drive")
        if not drive or drive.get("Removable") or drive.get("MediaRemovable"):
            continue
        model = drive.get("Model") or "Drive"
        nvme = ifaces.get("org.freedesktop.UDisks2.NVMe.Controller")
        ata = ifaces.get("org.freedesktop.UDisks2.Drive.Ata")
        if nvme:
            proxy = Gio.DBusProxy.new_sync(bus, 0, None, "org.freedesktop.UDisks2", path,
                                           "org.freedesktop.UDisks2.NVMe.Controller", None)
            attrs = proxy.call_sync("SmartGetAttributes", GLib.Variant("(a{sv})", ({},)),
                                    0, 10000, None).unpack()[0]
            used = attrs.get("percent_used", 0)
            spare = attrs.get("avail_spare", 100)
            errors = attrs.get("media_errors", 0)
            warnings = nvme.get("SmartCriticalWarning") or []
            temp = nvme.get("SmartTemperature", 0) - 273 if nvme.get("SmartTemperature") else None
            lvl = level(used, 80, 95)
            if errors or spare < 20:
                lvl = "warn" if lvl == "ok" else lvl
            if warnings or spare < 10:
                lvl = "bad"
            facts = [f"{temp} °C" if temp is not None else None,
                     f"{nvme.get('SmartPowerOnHours', 0):,} hours on",
                     f"{errors} error{'s' if errors != 1 else ''}"]
            lines = [model, " · ".join(f for f in facts if f)]
            if warnings:
                lines.append("Warning: " + ", ".join(warnings))
            cards.append({"title": "SSD life", "value": f"{max(0, 100 - used)}% left",
                          "fraction": max(0, 100 - used) / 100, "level": lvl, "lines": lines})
        elif ata and ata.get("SmartSupported") and ata.get("SmartEnabled"):
            failing = ata.get("SmartFailing")
            bad_sectors = ata.get("SmartNumBadSectors", 0)
            temp = ata.get("SmartTemperature", 0) - 273 if ata.get("SmartTemperature") else None
            hours = ata.get("SmartPowerOnSeconds", 0) // 3600
            lvl = "bad" if failing else "warn" if bad_sectors else "ok"
            facts = [f"{temp} °C" if temp is not None else None, f"{hours:,} hours on",
                     f"{bad_sectors} bad sector{'s' if bad_sectors != 1 else ''}"]
            cards.append({"title": "Drive health", "value": "Failing" if failing else "Healthy",
                          "fraction": None, "level": lvl,
                          "lines": [model, " · ".join(f for f in facts if f)]})
    return cards


def battery_cards(bus):
    from gi.repository import Gio
    upower = Gio.DBusProxy.new_sync(bus, 0, None, "org.freedesktop.UPower", "/org/freedesktop/UPower",
                                    "org.freedesktop.UPower", None)
    cards = []
    for path in upower.call_sync("EnumerateDevices", None, 0, 5000, None).unpack()[0]:
        dev = Gio.DBusProxy.new_sync(bus, 0, None, "org.freedesktop.UPower", path,
                                     "org.freedesktop.UPower.Device", None)
        prop = lambda name: (dev.get_cached_property(name).unpack()
                             if dev.get_cached_property(name) is not None else None)
        if prop("Type") != 2 or not prop("PowerSupply"):  # 2 = battery; skip mice and such
            continue
        capacity = prop("Capacity") or 0
        full, design = prop("EnergyFull") or 0, prop("EnergyFullDesign") or 0
        lines = [f"Holds {full:.1f} of {design:.1f} Wh when full" if design else "",
                 f"Charged to {prop('Percentage'):.0f}% now"]
        cards.append({"title": "Battery health", "value": f"{capacity:.0f}% of new",
                      "fraction": min(capacity, 100) / 100, "level": level(capacity, 70, 50, high_is_bad=False),
                      "lines": [line for line in lines if line]})
    return cards


def disk_card():
    st = os.statvfs("/")
    total, free = st.f_blocks * st.f_frsize, st.f_bavail * st.f_frsize
    taken = (st.f_blocks - st.f_bfree) * st.f_frsize
    used = taken / (taken + free) if taken + free else 0  # as df counts it: root's reserve is not "used"
    gb = lambda n: f"{n / 1e9:,.0f} GB" if n >= 1e10 else f"{n / 1e9:.1f} GB"
    return {"title": "Disk space", "value": f"{used * 100:.0f}% used", "fraction": used,
            "level": level(used * 100, 80, 90), "lines": [f"{gb(free)} free of {gb(total)}"]}


def memory_card():
    info = {}
    with open("/proc/meminfo") as f:
        for line in f:
            key, value = line.split(":", 1)
            info[key] = int(value.split()[0])  # kB
    total, available = info["MemTotal"], info.get("MemAvailable", info["MemFree"])
    used = 1 - available / total
    return {"title": "Memory", "value": f"{used * 100:.0f}% in use", "fraction": used,
            "level": level(used * 100, 85, 95),
            "lines": [f"{(total - available) / 1048576:.1f} of {total / 1048576:.1f} GiB in use"]}


def health():
    """Cards for the overview: drives, disk space, battery, memory. Never raises."""
    cards = []
    try:
        import gi
        gi.require_version("Gio", "2.0")
        from gi.repository import Gio
        bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
    except Exception:
        bus = None
    if bus is not None:
        try:
            cards += drive_cards(bus)
        except Exception:
            pass
    if not any(c["title"] in ("SSD life", "Drive health") for c in cards):
        cards.append({"title": "Drive health", "value": "Not available", "fraction": None, "level": "none",
                      "lines": ["This drive does not report its health (common in virtual machines)."]})
    cards.append(disk_card())
    if bus is not None:
        try:
            cards += battery_cards(bus)
        except Exception:
            pass
    cards.append(memory_card())
    return cards


# ---- checks ----

class Check:
    def __init__(self, key, section):
        self.key = key
        self.name = section.get("name", key)
        self.group = section.get("group", "checkup")
        self.test = section.get("test", "true")
        self.detail = section.get("detail", "")
        self.fix = section.get("fix", "")
        self.root = section.getboolean("root", fallback=False)
        self.explain = section.get("explain", "")
        self.after = section.get("after", "")

    def passes(self):
        return shell(self.test)[0] == 0

    def details(self):
        """Short result text, such as '3 update(s) waiting' (at most 4 lines)."""
        if not self.detail:
            return ""
        return "\n".join(shell(self.detail)[1].splitlines()[:4])

    def fix_command(self, askpass=False):
        """The command that applies the fix. In the window, sudo asks with kos-askpass (-A)."""
        if not self.root:
            return ["sh", "-c", self.fix]
        return ["sudo", "-A", "sh", "-c", self.fix] if askpass else ["sudo", "sh", "-c", self.fix]

    def shown_command(self):
        """The fix as a person would type it."""
        return f"{'sudo ' if self.root else ''}sh -c '{self.fix}'"


def load_checks():
    parser = configparser.ConfigParser(interpolation=None)
    if not parser.read(CHECKS_FILE):
        sys.exit(f"kos-doctor: cannot read {CHECKS_FILE}")
    return [Check(key, parser[key]) for key in parser.sections()]


def load_ignored():
    try:
        with open(IGNORED_FILE) as f:
            return {line.strip() for line in f if line.strip()}
    except OSError:
        return set()


def save_ignored(ignored):
    os.makedirs(os.path.dirname(IGNORED_FILE), exist_ok=True)
    with open(IGNORED_FILE, "w") as f:
        f.writelines(f"{key}\n" for key in sorted(ignored))


def find(checks, key):
    for check in checks:
        if check.key == key:
            return check
    sys.exit(f"kos-doctor: no check called '{key}' (see kos-doctor --check)")


# ---- terminal ----

def check_all(checks):
    colour = {"ok": OK, "warn": WARN, "bad": BAD, "none": DIM}
    print("Health:")
    for card in health():
        print(f"  {colour[card['level']]}{card['title']}: {card['value']}{END}")
        for line in card["lines"]:
            print(f"    {DIM}{line}{END}")
    print()
    ignored = load_ignored()
    problems = 0
    for group, title in GROUPS:
        print(f"{title}:")
        for check in (c for c in checks if c.group == group):
            if check.key in ignored:
                print(f"  {DIM}IGNORED  {check.name}  (kos-doctor --unignore {check.key}){END}")
                continue
            ok = check.passes()
            status = f"{OK}OK{END}     " if ok else f"{BAD}PROBLEM{END}"
            if not ok:
                problems += 1
            hint = "" if ok else f"  {DIM}({'kos-doctor --fix ' + check.key if check.fix else 'no automatic fix'}){END}"
            print(f"  {status}  {check.name}{hint}")
            for line in check.details().splitlines():
                print(f"             {DIM}{line}{END}")
        print()
    if problems:
        print(f"{problems} problem(s). 'kos-doctor --explain ID' says what each one is.")
    else:
        print("Everything looks good.")
    return 1 if problems else 0


def explain(check):
    print(f"{check.name}  [{check.key}]")
    if check.explain:
        print(f"  {check.explain}")
    print(f"  Status: {'OK' if check.passes() else 'needs fixing'}")
    details = check.details()
    if details:
        print("  " + details.replace("\n", "\n  "))
    if check.fix:
        print(f"  Fix{' (needs your password)' if check.root else ''}:")
        print(f"    {check.shown_command()}")
    return 0


def fix(check, assume_yes):
    if check.passes():
        print(f"{check.name}: already OK, nothing to do.")
        return 0
    if not check.fix:
        print(f"{check.name}: there is no automatic fix.")
        if check.explain:
            print(f"  {check.explain}")
        return 1
    print(f"{check.name}")
    if check.explain:
        print(f"  {check.explain}")
    print("  This will run:")
    print(f"    {check.shown_command()}")
    if not assume_yes and input("  Run it? [y/N] ").strip().lower() not in ("y", "yes"):
        print("  Not changed.")
        return 1
    if subprocess.run(check.fix_command()).returncode != 0:
        print(f"  {BAD}The fix failed.{END}")
        return 1
    if check.passes():
        print(f"  {OK}Fixed.{END}{' ' + check.after if check.after else ''}")
        return 0
    print(f"  {BAD}The fix ran, but the check still fails.{END}{' ' + check.after if check.after else ''}")
    return 1


def set_ignored(check, ignore):
    ignored = load_ignored()
    if ignore:
        ignored.add(check.key)
    else:
        ignored.discard(check.key)
    save_ignored(ignored)
    print(f"{check.name}: {'ignored' if ignore else 'checked again from now on'}.")
    return 0


# ---- window ----

def run_window(checks):
    import gi
    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    gi.require_version("GdkPixbuf", "2.0")
    from gi.repository import Gdk, GdkPixbuf, GLib, Gtk

    # KOS teal on the dark theme, as in KOS Software; amber and red for warnings
    css = Gtk.CssProvider()
    css.load_from_data(b"""
    .kos-name { font-weight: bold; font-size: 1.1em; }
    .kos-dim { opacity: 0.7; }
    .kos-ok { color: #3fd0ef; font-weight: bold; }
    .kos-warn { color: #e8b04a; font-weight: bold; }
    .kos-problem { color: #ef6b6b; font-weight: bold; }
    .kos-summary { font-size: 1.2em; font-weight: bold; }
    .kos-command { font-family: monospace; opacity: 0.8; }
    .kos-card { background-color: alpha(#3fd0ef, 0.06); border: 1px solid alpha(#3fd0ef, 0.25);
                border-radius: 8px; padding: 12px; }
    .kos-card-title { opacity: 0.75; }
    .kos-card-value { font-size: 1.5em; font-weight: bold; }
    .kos-card levelbar trough { min-height: 8px; border-radius: 4px; }
    .kos-card levelbar block.filled { background-color: #3fd0ef; border-radius: 4px; }
    .kos-card.warn levelbar block.filled { background-color: #e8b04a; }
    .kos-card.bad levelbar block.filled { background-color: #ef6b6b; }
    .kos-card.warn .kos-card-value { color: #e8b04a; }
    .kos-card.bad .kos-card-value { color: #ef6b6b; }
    .kos-card.ok .kos-card-value { color: #3fd0ef; }
    button.kos-accent { background-image: none; background-color: #1f7f99; color: #ffffff; }
    button.kos-accent:hover { background-color: #3fd0ef; color: #03060f; }
    """)
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css,
                                             Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    Gtk.Settings.get_default().set_property("gtk-application-prefer-dark-theme", True)

    def health_card(card):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        box.set_size_request(230, -1)
        style = box.get_style_context()
        style.add_class("kos-card")
        style.add_class(card["level"])
        title = Gtk.Label(label=card["title"], xalign=0)
        title.get_style_context().add_class("kos-card-title")
        box.pack_start(title, False, False, 0)
        value = Gtk.Label(label=card["value"], xalign=0)
        value.get_style_context().add_class("kos-card-value")
        box.pack_start(value, False, False, 0)
        if card["fraction"] is not None:
            bar = Gtk.LevelBar(min_value=0, max_value=1, value=max(0.0, min(1.0, card["fraction"])))
            for name in ("low", "high", "full"):  # our own colours instead of GTK's
                bar.remove_offset_value(name)
            box.pack_start(bar, False, False, 2)
        for line in card["lines"]:
            label = Gtk.Label(label=line, xalign=0, wrap=True, max_width_chars=34)
            label.get_style_context().add_class("kos-dim")
            box.pack_start(label, False, False, 0)
        box.show_all()
        return box

    class CheckRow(Gtk.ListBoxRow):
        def __init__(self, check, window):
            super().__init__(activatable=False)
            self.check = check
            self.state = "checking"
            box = Gtk.Box(spacing=12, margin=10)
            self.status = Gtk.Label(label="…", width_chars=9, xalign=0)
            box.pack_start(self.status, False, False, 0)

            text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
            name = Gtk.Label(label=check.name, xalign=0)
            name.get_style_context().add_class("kos-name")
            text.pack_start(name, False, False, 0)
            self.result = Gtk.Label(xalign=0, wrap=True, max_width_chars=70, selectable=True)
            text.pack_start(self.result, False, False, 0)
            self.detail = Gtk.Label(label=check.explain, xalign=0, wrap=True, max_width_chars=70)
            self.detail.get_style_context().add_class("kos-dim")
            text.pack_start(self.detail, False, False, 0)
            self.note = Gtk.Label(xalign=0, wrap=True, max_width_chars=70)
            text.pack_start(self.note, False, False, 0)
            self.command = Gtk.Label(label=check.shown_command() if check.fix else "", xalign=0,
                                     wrap=True, max_width_chars=70, selectable=True)
            self.command.get_style_context().add_class("kos-command")
            text.pack_start(self.command, False, False, 0)
            box.pack_start(text, True, True, 0)

            buttons = Gtk.Box(spacing=6, valign=Gtk.Align.CENTER)
            self.show_button = Gtk.ToggleButton(label="Show command")
            self.show_button.connect("toggled", lambda b: self.command.set_visible(b.get_active()))
            buttons.pack_start(self.show_button, False, False, 0)
            self.ignore_button = Gtk.Button(label="Ignore")
            self.ignore_button.set_tooltip_text("Stop reporting this check")
            self.ignore_button.connect("clicked", lambda b: window.toggle_ignore(self))
            buttons.pack_start(self.ignore_button, False, False, 0)
            self.fix_button = Gtk.Button(label="Fix")
            if check.root:
                self.fix_button.set_tooltip_text("Needs your password")
            self.fix_button.get_style_context().add_class("kos-accent")
            self.fix_button.connect("clicked", lambda b: window.fix(self))
            buttons.pack_start(self.fix_button, False, False, 0)
            box.pack_end(buttons, False, False, 0)
            self.add(box)

        def set_state(self, state, note="", result=""):
            """state: checking, ok, problem, fixing, failed, ignored"""
            self.state = state
            labels = {"checking": "Checking", "ok": "OK", "problem": "Problem",
                      "fixing": "Fixing…", "failed": "Problem", "ignored": "Ignored"}
            style = self.status.get_style_context()
            for name in ("kos-ok", "kos-problem", "kos-dim"):
                style.remove_class(name)
            if state == "ok":
                style.add_class("kos-ok")
            elif state in ("problem", "failed"):
                style.add_class("kos-problem")
            elif state == "ignored":
                style.add_class("kos-dim")
            self.status.set_label(labels[state])
            needs_fix = state in ("problem", "failed")
            self.result.set_label(result)
            self.result.set_visible(bool(result) and state != "ignored")
            self.detail.set_visible(needs_fix and bool(self.check.explain))
            self.note.set_label(note)
            self.note.set_visible(bool(note))
            self.fix_button.set_visible(needs_fix and bool(self.check.fix))
            self.show_button.set_visible(needs_fix and bool(self.check.fix))
            self.ignore_button.set_visible(needs_fix or state == "ignored")
            self.ignore_button.set_label("Stop ignoring" if state == "ignored" else "Ignore")
            if not needs_fix:
                self.show_button.set_active(False)
            self.command.set_visible(self.show_button.get_active())

    class DoctorWindow(Gtk.Window):
        def __init__(self):
            super().__init__(title="KOS Doctor")
            self.set_default_size(900, 720)
            self.busy = False
            self.ignored = load_ignored()

            header = Gtk.HeaderBar(show_close_button=True)
            header.set_decoration_layout(":minimize,maximize,close")
            self.set_titlebar(header)
            try:
                self.set_icon_from_file(LOGO)
                logo = GdkPixbuf.Pixbuf.new_from_file_at_scale(LOGO, 32, 32, True)
                header.pack_start(Gtk.Image.new_from_pixbuf(logo))
            except GLib.Error:
                pass
            self.again = Gtk.Button(label="Check again")
            self.again.connect("clicked", lambda b: self.check_everything())
            header.pack_end(self.again)

            # Two pages: the checkup, and catch-up fixes for older KrelboyneOS versions
            self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE)
            header.set_custom_title(Gtk.StackSwitcher(stack=self.stack))
            self.add(self.stack)
            self.rows = []
            self.pages = {}

            for group, title in GROUPS:
                page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, margin=12)
                if group == "checkup":
                    self.summary = Gtk.Label(xalign=0)
                    self.summary.get_style_context().add_class("kos-summary")
                    page.pack_start(self.summary, False, False, 0)
                    self.cards = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, homogeneous=True,
                                             min_children_per_line=2, max_children_per_line=4,
                                             column_spacing=10, row_spacing=10)
                    page.pack_start(self.cards, False, False, 6)
                    hint_text = ("Nothing changes until you press Fix. Fixes that change system settings "
                                 "ask for your password.")
                else:
                    hint_text = ("Fixes for problems that older KrelboyneOS versions shipped with. "
                                 "On an up-to-date system these are all OK.")
                hint = Gtk.Label(xalign=0, wrap=True, label=hint_text)
                hint.get_style_context().add_class("kos-dim")
                page.pack_start(hint, False, False, 4)

                listbox = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
                for check in (c for c in checks if c.group == group):
                    row = CheckRow(check, self)
                    self.rows.append(row)
                    listbox.add(row)
                if group == "checkup":
                    # the whole checkup page scrolls, cards included
                    page.pack_start(listbox, False, False, 0)
                    scroller = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
                    scroller.add(page)
                    self.stack.add_titled(scroller, group, title)
                    self.pages[group] = scroller
                else:
                    scroller = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
                    scroller.add(listbox)
                    page.pack_start(scroller, True, True, 0)
                    self.stack.add_titled(page, group, title)
                    self.pages[group] = page

        def set_busy(self, busy):
            self.busy = busy
            self.again.set_sensitive(not busy)
            for row in self.rows:
                row.fix_button.set_sensitive(not busy)
                row.ignore_button.set_sensitive(not busy)

        def show_health(self, cards):
            for child in self.cards.get_children():
                self.cards.remove(child)
            for card in cards:
                self.cards.add(health_card(card))
            self.cards.show_all()

        def update_summary(self):
            counts = {group: sum(1 for row in self.rows
                                 if row.check.group == group and row.state in ("problem", "failed"))
                      for group, _ in GROUPS}
            older = counts["catch-up"]
            self.stack.child_set_property(self.pages["catch-up"], "title",
                                          f"Older versions ({older})" if older else "Older versions")
            here = counts["checkup"]
            if here and older:
                self.summary.set_label(f"{here} problem{'s' if here > 1 else ''} here, "
                                       f"{older} on Older versions")
            elif here:
                self.summary.set_label(f"{here} problem{'s' if here > 1 else ''} found")
            elif older:
                self.summary.set_label(f"No problems here; {older} on Older versions")
            else:
                self.summary.set_label("Everything looks good")

        def check_one(self, row):
            """Runs in a worker thread."""
            if row.check.key in self.ignored:
                GLib.idle_add(row.set_state, "ignored")
                return
            ok = row.check.passes()
            note = "" if ok or row.check.fix else "There is no automatic fix for this one."
            GLib.idle_add(row.set_state, "ok" if ok else "problem", note, row.check.details())

        def check_everything(self):
            if self.busy:
                return
            self.set_busy(True)
            self.summary.set_label("Checking…")
            for row in self.rows:
                row.set_state("checking")

            def worker():
                GLib.idle_add(self.show_health, health())
                for row in self.rows:
                    self.check_one(row)
                GLib.idle_add(self.done_checking)

            threading.Thread(target=worker, daemon=True).start()

        def done_checking(self):
            self.set_busy(False)
            self.update_summary()

        def toggle_ignore(self, row):
            if self.busy:
                return
            if row.check.key in self.ignored:
                self.ignored.discard(row.check.key)
            else:
                self.ignored.add(row.check.key)
            save_ignored(self.ignored)
            self.set_busy(True)

            def worker():
                self.check_one(row)
                GLib.idle_add(self.done_checking)

            threading.Thread(target=worker, daemon=True).start()

        def fix(self, row):
            if self.busy:
                return
            self.set_busy(True)
            row.set_state("fixing", "Waiting for your password…" if row.check.root else "")
            env = dict(os.environ, SUDO_ASKPASS=ASKPASS, KOS_ASKPASS_TITLE="KOS Doctor")

            def worker():
                try:
                    result = subprocess.run(row.check.fix_command(askpass=True), stdin=subprocess.DEVNULL,
                                            capture_output=True, text=True, errors="replace", env=env)
                    code, output = result.returncode, (result.stdout + result.stderr).strip()
                except OSError as error:
                    code, output = 1, str(error)
                ok = code == 0 and row.check.passes()
                GLib.idle_add(self.fix_finished, row, ok, code, output, row.check.details())

            threading.Thread(target=worker, daemon=True).start()

        def fix_finished(self, row, ok, code, output, details):
            after = row.check.after
            if ok:
                row.set_state("ok", f"Fixed. {after}".strip(), details)
            elif code == 0:
                row.set_state("failed", f"The fix ran, but the check still fails. {after}".strip(), details)
            else:
                last = "\n".join(output.splitlines()[-3:])
                row.set_state("failed", f"The fix did not work.{chr(10) + last if last else ''}", details)
            self.set_busy(False)
            self.update_summary()

    window = DoctorWindow()
    window.connect("destroy", Gtk.main_quit)
    window.show_all()
    for row in window.rows:
        row.set_state("checking")
    window.check_everything()
    Gtk.main()
    return 0


def main():
    parser = argparse.ArgumentParser(prog="kos-doctor", description="A checkup for KrelboyneOS: health overview, find and fix common problems.")
    group = parser.add_mutually_exclusive_group()
    group.add_argument("--check", action="store_true", help="health and checks in the terminal")
    group.add_argument("--fix", metavar="ID", help="fix one problem, after asking")
    group.add_argument("--explain", metavar="ID", help="say what a check looks for and how it is fixed")
    group.add_argument("--ignore", metavar="ID", help="stop reporting a check")
    group.add_argument("--unignore", metavar="ID", help="report an ignored check again")
    parser.add_argument("-y", "--yes", action="store_true", help="with --fix, do not ask first")
    args = parser.parse_args()

    if os.geteuid() == 0:
        sys.exit("kos-doctor: run it as yourself, not as root; it asks for your password when a fix needs it")

    checks = load_checks()
    if args.fix:
        return fix(find(checks, args.fix), args.yes)
    if args.explain:
        return explain(find(checks, args.explain))
    if args.ignore or args.unignore:
        return set_ignored(find(checks, args.ignore or args.unignore), bool(args.ignore))
    if args.check or not (os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")):
        return check_all(checks)
    return run_window(checks)


if __name__ == "__main__":
    sys.exit(main())
