#!/bin/sh
set -e
# Login screen settings go in the greeter's /etc config file, which dpkg
# keeps on upgrades (the /usr/share conf.d file gets replaced)
F=/etc/lightdm/lightdm-gtk-greeter.conf
grep -q '^# KrelboyneOS' $F || sed -i '/^\[greeter\]/a # KrelboyneOS\
background=/usr/share/krelboyneos/branding/login.jpg\
theme-name=Arc-Dark' $F
