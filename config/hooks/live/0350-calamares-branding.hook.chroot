#!/bin/sh
set -e
B=/etc/calamares/branding/debian
S=/usr/share/krelboyneos/branding
cp $S/logo.png $B/krelboyneos-logo.png
cp $S/welcome.png $B/krelboyneos-welcome.png
sed -i \
  -e 's|^\( *productName:\) .*|\1 "KrelboyneOS"|' \
  -e 's|^\( *shortProductName:\) .*|\1 "KrelboyneOS"|' \
  -e 's|^\( *version:\) .*|\1 "0.1.2"|' \
  -e 's|^\( *shortVersion:\) .*|\1 "0.1.2"|' \
  -e 's|^\( *versionedName:\) .*|\1 "KrelboyneOS 0.1.2"|' \
  -e 's|^\( *shortVersionedName:\) .*|\1 "KrelboyneOS 0.1.2"|' \
  -e 's|^\( *bootloaderEntryName:\) .*|\1 "KrelboyneOS"|' \
  -e 's|^\( *productLogo:\) .*|\1 "krelboyneos-logo.png"|' \
  -e 's|^\( *productIcon:\) .*|\1 "krelboyneos-logo.png"|' \
  -e 's|^\( *productWelcome:\) .*|\1 "krelboyneos-welcome.png"|' \
  -e 's|^\( *productUrl:\) .*|\1 https://github.com/grumpy-gaming/KrelboyneOS|' \
  -e 's|^\( *supportUrl:\) .*|\1 https://discord.gg/hzUZDPwBs7|' \
  -e 's|^\( *knownIssuesUrl:\) .*|\1 https://discord.gg/hzUZDPwBs7|' \
  -e 's|^\( *releaseNotesUrl:\) .*|\1 https://github.com/grumpy-gaming/KrelboyneOS/releases|' \
  -e 's|^\( *donateUrl:\) .*|\1 https://ko-fi.com/krelboyneos|' \
  $B/branding.desc
# Show the Donate button (Ko-fi) on the welcome page
W=/etc/calamares/modules/welcome.conf
grep -q '^showDonateUrl:' $W || sed -i '/^showReleaseNotesUrl:/a showDonateUrl:          true' $W
D=/usr/share/applications/calamares-install-debian.desktop
sed -i -e 's|^Name=.*|Name=Install KrelboyneOS|' $D
sed -i -e 's|^Comment=.*|Comment=Install KrelboyneOS to disk|' $D
sed -i -e 's|^Icon=.*|Icon=/usr/share/krelboyneos/branding/logo.png|' $D
