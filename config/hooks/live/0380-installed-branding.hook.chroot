#!/bin/sh
set -e
# GRUB theme fonts (GRUB needs its own .pf2 font format)
T=/boot/grub/themes/krelboyneos
F=/usr/share/fonts/truetype/dejavu
grub-mkfont -s 16 -o $T/dejavu_sans_16.pf2 $F/DejaVuSans.ttf
grub-mkfont -s 16 -o $T/dejavu_sans_bold_16.pf2 $F/DejaVuSans-Bold.ttf
grub-mkfont -s 12 -o $T/dejavu_sans_12.pf2 $F/DejaVuSans.ttf
# KrelboyneOS boot splash (the installer rebuilds the initramfs with it)
plymouth-set-default-theme krelboyneos
